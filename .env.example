# Execution server
PORT=4000
HOST=0.0.0.0

# XAUUSD quote simulation (used when no live broker feed is attached)
TICK_INTERVAL_MS=400
SEED_PRICE=3312.4
HISTORY_BARS=240
# Set for a reproducible price series (useful for backtest-style runs)
# RANDOM_SEED=42

# Serve the built web terminal from the API process (npm run build && npm start)
SERVE_WEB=true


# ---------------------------------------------------------------------------
# MetaApi — trade your MetaTrader accounts from this server, around the clock.
# Leave METAAPI_TOKEN empty to run the demo market instead.
# ---------------------------------------------------------------------------
# API access token from https://app.metaapi.cloud/token
METAAPI_TOKEN=
# MetaApi id of the master account (the log lists your ids when this is empty)
METAAPI_MASTER_ID=
# Comma-separated MetaApi ids of the accounts that copy the master
METAAPI_FOLLOWER_IDS=
# The master's gold symbol; empty finds it (XAUUSD, XAUUSDm, GOLD…)
METAAPI_SYMBOL=
# Follower lot = master lot x this
FOLLOWER_MULTIPLIER=1
# "true" sends real orders; anything else fills on paper against real quotes
LIVE_EXECUTION=false
# Required with LIVE_EXECUTION=true. Open the site once as /?key=<ACCESS_KEY>.
ACCESS_KEY=
# "true" starts the bot by itself after every restart
AUTO_START_BOT=false
# An .mq5 or .ex5 to load when none has been uploaded (e.g. /strategies/Angel_Bot.mq5)
STRATEGY_FILE=
# Where the uploaded strategy and settings are kept across restarts
STATE_DIR=./data
