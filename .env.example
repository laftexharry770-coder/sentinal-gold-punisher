# Execution server
PORT=4000
HOST=0.0.0.0

# XAUUSD quote simulation (used when no live broker feed is attached)
TICK_INTERVAL_MS=400
SEED_PRICE=3312.4
HISTORY_BARS=240
# Set for a reproducible price series (useful for backtest-style runs)
# RANDOM_SEED=42

# Serve the built web terminal from the API process (npm run build && npm start)
SERVE_WEB=true

# MetaApi cloud — required only for accounts linked with provider "metaapi".
# The token stays on the server and is never sent to the browser.
METAAPI_TOKEN=
METAAPI_REGION=new-york
